{
  "manifest_version": 3,
  "name": "Haxity Emotes in Vaughn",
  "icons": {
    "128": "icons/pidser.png"
  },
  "action": {
    "default_icon": "icons/pidser.png"
  },
  "version": "1.0.2",
  "description": "Renders Haxity's selected 7TV, BTTV, and FrankerFacez emotes in Vaughn Live chat.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://7tv.io/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://vaughn.live/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "uncxity-emotes@vaughn.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
